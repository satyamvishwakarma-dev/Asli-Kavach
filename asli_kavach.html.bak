<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Asli Kavach · AI media verification</title>
<link rel="icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&display=swap" rel="stylesheet">
<style>
:root{--ink:#0f2447;--muted:#41506b;--saffron:#FF9933;--green:#138808;--red:#D7261E;--line:rgba(15,36,71,.14)}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{background:#8cc8f5;scroll-behavior:smooth;scroll-padding-top:24px}
body{margin:0;color:var(--ink);font:17px/1.55 "Plus Jakarta Sans","Segoe UI",system-ui,sans-serif;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
button{font:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--ink);outline-offset:2px}
.i{width:1.25em;height:1.25em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}

#sky{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none;
 background:radial-gradient(70vw 32vh at 0% 100%,rgba(255,153,51,.65),transparent 70%),radial-gradient(70vw 32vh at 100% 100%,rgba(19,136,8,.5),transparent 70%),linear-gradient(#6fb8f2 0%,#a6d5f8 45%,#e8f4ff 100%)}
.cloud{position:absolute;width:380px;height:110px;border-radius:50%;background:#fff;filter:blur(22px);opacity:.9;animation:drift 100s linear infinite}
@keyframes drift{from{transform:translateX(-440px)}to{transform:translateX(calc(100vw + 440px))}}
.fly{position:absolute;bottom:var(--y);width:92px;height:32px;color:var(--c);opacity:0;animation:fl 15s linear infinite;animation-delay:var(--d)}
.fly.l{left:0}.fly.r{right:0;--s:-1}
.fly svg{width:100%;height:100%;display:block;filter:drop-shadow(0 1px 1px rgba(0,0,0,.35))}
.trail{position:absolute;right:80px;top:11px;width:60vw;height:10px;border-radius:5px;background:linear-gradient(90deg,transparent,var(--c) 70%);box-shadow:0 0 14px var(--c);filter:blur(1.5px)}
@keyframes fl{0%{opacity:0;transform:scaleX(var(--s,1)) rotate(-20deg) translateX(-30vw)}6%,55%{opacity:1}65%,100%{opacity:0;transform:scaleX(var(--s,1)) rotate(-20deg) translateX(135vw)}}
#skyline{position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:max(100%,1400px);height:auto;display:block}
@media(prefers-reduced-motion:reduce){.fly{display:none}.cloud{animation:none}html{scroll-behavior:auto}}

.app{position:relative;z-index:1}
.nav{position:relative;z-index:20;width:calc(100% - 32px);max-width:1120px;margin:calc(12px + env(safe-area-inset-top,0px)) auto 0;background:rgba(255,255,255,.82);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.75);border-radius:20px;box-shadow:0 10px 30px rgba(15,36,71,.18)}
.in{padding:0 12px 0 16px;display:flex;align-items:center;justify-content:space-between;height:64px}
.brand{display:flex;align-items:center;gap:6px;font-weight:800;font-size:1.25rem}
.logo{width:auto;height:40px;margin-right:2px}
.brand .r{color:var(--red)}
.links{display:flex;align-items:center;gap:22px;font-weight:600}
@media(max-width:640px){.links a:not(.btn){display:none}}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 20px;border-radius:12px;border:2px solid transparent;background:#fff;color:var(--ink);font-weight:700}
.btn:hover{filter:brightness(1.06)}
.btn.go{min-height:42px;background:var(--saffron);color:#2b1600}
.btn.primary{background:var(--ink);color:#fff}
.btn.green{background:var(--green);color:#fff}
.btn.ghost{background:rgba(255,255,255,.9);border-color:var(--line)}
.btn.red{background:var(--red);color:#fff}
.btn:disabled{opacity:.4}

.hero{max-width:1120px;margin:0 auto;padding:72px 20px 48px}
h1{font-size:clamp(2.4rem,6.5vw,4.2rem);line-height:1.05;margin:0 0 16px;font-weight:800;letter-spacing:-.03em;max-width:14em}
h1 em{font-style:normal;color:var(--red)}
.hero p{font-size:1.2rem;max-width:34em;margin:0 0 26px}
.cta{display:flex;gap:12px;flex-wrap:wrap}

section{max-width:1120px;margin:0 auto;padding:40px 20px}
h2{font-size:clamp(1.7rem,4vw,2.3rem);margin:0 0 6px;font-weight:800;letter-spacing:-.02em}
.lead{margin:0 0 22px}
.tool{background:rgba(255,255,255,.95);border:1px solid var(--line);border-radius:22px;padding:18px;box-shadow:0 20px 50px rgba(15,36,71,.18)}
.seg{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:6px;border-radius:14px;background:#e9eef6}
.seg button{display:flex;align-items:center;justify-content:center;gap:8px;min-height:50px;border:0;border-radius:10px;background:transparent;color:var(--muted);font-weight:700}
.seg button.on{background:var(--ink);color:#fff}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:18px}
@media(max-width:820px){.cols{grid-template-columns:1fr}}
.ctrls{display:flex;flex-wrap:wrap;gap:10px}
.ctrls .btn{flex:1 1 150px}
.viz{margin-top:14px;height:190px;border-radius:14px;background:#f4f8fc;border:2px dashed var(--line);position:relative;overflow:hidden}
.viz canvas,.viz video{width:100%;height:100%;display:block}
.viz img{width:100%;height:100%;object-fit:contain;display:none}
.ph{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--muted);font-weight:600;font-size:.9rem;pointer-events:none}
.ph .i{width:48px;height:48px;opacity:.6}
#cap{width:100%;margin-top:12px;background:#fff;border:1px solid var(--line);color:var(--ink);padding:12px;border-radius:10px;font:inherit;font-size:.9rem}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px;padding-top:14px;border-top:1px solid var(--line);text-align:center}
.stats div{display:flex;flex-direction:column;align-items:center}
.stats .i{color:var(--muted)}
.stats small{margin:0}
.stats b{font-size:1rem}
.box{--c:#2f4a7a;border:2px solid var(--c);border-radius:16px;overflow:hidden;background:#fff}
.box.real{--c:#138808}.box.fake{--c:#D7261E}.box.maybe{--c:#b45f00}.box.err{--c:#4b5563}
.hd{display:flex;align-items:center;gap:14px;padding:16px;background:var(--c);color:#fff}
#ic{display:grid}
#ic .i{width:2.4rem;height:2.4rem}
.spin .i{animation:sp 1s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
.hd h3{margin:0;font-size:1.3rem;line-height:1.2}
.hd p{margin:2px 0 0;font-size:.9rem}
.bar{position:relative;height:22px;margin:26px 18px 6px;border-radius:11px;background:linear-gradient(90deg,var(--green),#e0b000,var(--red))}
.bar i{position:absolute;top:-6px;left:0;width:8px;height:34px;margin-left:-4px;border-radius:4px;background:var(--ink);border:2px solid #fff;transition:left .4s}
#pct{margin:8px 18px 14px;font-weight:700}
#heat{display:block;width:calc(100% - 36px);height:50px;margin:0 18px 18px;border-radius:8px}
#say{width:100%;margin-top:12px}
#ctx h3{font-size:1rem;margin:16px 0 6px}
#ctxL a{display:block;padding:6px 0;border-top:1px solid var(--line);font-size:.9rem;word-break:break-word}
small{display:block;margin-top:12px;color:var(--muted);font-size:.8rem}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
@media(max-width:760px){.steps{grid-template-columns:1fr}}
.card{background:rgba(255,255,255,.93);border:1px solid var(--line);border-radius:18px;padding:22px}
.card h3{margin:0 0 6px;font-size:1.15rem}
.card p{margin:0;color:var(--muted);font-size:.95rem}
.ico{display:grid;place-items:center;width:46px;height:46px;border-radius:12px;margin-bottom:14px;color:#fff;background:var(--ink)}
.card:first-child .ico{background:var(--saffron);color:#2b1600}
.card:last-child .ico{background:var(--green)}
.foot{max-width:1120px;margin:0 auto;padding:30px 20px 20vh}
.foot p{margin:4px 0 0}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5z"/><path d="M9 12l2 2 4-4"/></symbol><symbol id="i-mic" viewBox="0 0 24 24"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v4"/></symbol><symbol id="i-video" viewBox="0 0 24 24"><rect x="2" y="6" width="14" height="12" rx="2"/><path d="M22 8l-6 4 6 4z"/></symbol><symbol id="i-image" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-5-5L5 21"/></symbol><symbol id="i-camera" viewBox="0 0 24 24"><path d="M3 8a2 2 0 0 1 2-2h2l2-2h6l2 2h2a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><circle cx="12" cy="13" r="4"/></symbol><symbol id="i-monitor" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></symbol><symbol id="i-upload" viewBox="0 0 24 24"><path d="M12 16V4M7 9l5-5 5 5M4 20h16"/></symbol><symbol id="i-volume" viewBox="0 0 24 24"><path d="M11 5L6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></symbol><symbol id="i-stop" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2"/></symbol><symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol><symbol id="i-layers" viewBox="0 0 24 24"><path d="M12 2l10 5-10 5L2 7z"/><path d="M2 12l10 5 10-5M2 17l10 5 10-5"/></symbol><symbol id="i-activity" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></symbol><symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></symbol><symbol id="i-alert" viewBox="0 0 24 24"><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></symbol><symbol id="i-help" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01"/></symbol><symbol id="i-scan" viewBox="0 0 24 24"><path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="10" r="3"/><path d="M7 17c1-3 9-3 10 0"/></symbol><symbol id="i-ban" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M4.9 4.9l14.2 14.2"/></symbol><symbol id="i-loader" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-6.2-8.6"/></symbol></svg>
<div id="sky">
  <div class="cloud" style="top:6%;animation-delay:-20s"></div>
  <div class="cloud" style="top:26%;animation-delay:-65s;animation-duration:130s"></div>
  <div class="cloud" style="top:48%;animation-delay:-40s;animation-duration:115s"></div>
  <img id="skyline" alt="" src="data:image/png;base64,">
</div>
<div class="app">
<nav class="nav"><div class="in">
  <a class="brand" href="#top"><img class="logo" alt="" src="data:image/png;base64,"><span class="r">Asli</span><span>Kavach</span></a>
  <div class="links"><a href="#detector">Detector</a><a href="#how">How it works</a><a class="btn go" href="#detector">Try it now</a></div>
</div></nav>

<header class="hero" id="top">
  <h1>Know what's real.<br><em>Before you share it.</em></h1>
  <p>Asli Kavach checks voice, video and photos for signs of AI generation and explains the result in plain language.</p>
  <div class="cta"><a class="btn primary" href="#detector">Check media</a><a class="btn ghost" href="#how">How it works</a></div>
</header>

<section id="detector">
  <h2>Check your media</h2>
  <p class="lead">Choose a type, then add a file or go live.</p>
  <div class="tool">
    <div class="seg">
      <button data-m="audio"><svg class="i"><use href="#i-mic"/></svg>Voice</button>
      <button data-m="video"><svg class="i"><use href="#i-video"/></svg>Video</button>
      <button data-m="image"><svg class="i"><use href="#i-image"/></svg>Photo</button>
    </div>
    <div class="cols">
      <div>
        <div class="ctrls">
          <button class="btn green" id="liveBtn"><span id="liveI"></span><span id="liveT"></span></button>
          <button class="btn ghost" id="scrBtn" hidden><svg class="i"><use href="#i-monitor"/></svg>Share screen</button>
          <button class="btn primary" id="pick"><svg class="i"><use href="#i-upload"/></svg>Upload file</button>
          <input type="file" id="f" hidden>
        </div>
        <div class="viz">
          <canvas id="wave" width="800" height="190"></canvas>
          <video id="vid" muted playsinline style="display:none"></video>
          <img id="img" alt="">
          <div class="ph" id="ph"></div>
        </div>
        <input id="cap" type="text" maxlength="200" placeholder="Caption or claim that came with it (optional)">
        <div class="stats">
          <div><svg class="i"><use href="#i-clock"/></svg><small>Latency</small><b id="sLat">—</b></div>
          <div><svg class="i"><use href="#i-layers"/></svg><small>Frames</small><b id="sFr">—</b></div>
          <div><svg class="i"><use href="#i-activity"/></svg><small>Status</small><b id="sSt">Idle</b></div>
        </div>
      </div>
      <div>
        <div class="box" id="box">
          <div class="hd"><span id="ic"></span><div><h3 id="vt"></h3><p id="vs"></p></div></div>
          <div class="bar" id="bar"><i id="mk"></i></div>
          <p id="pct"></p>
          <canvas id="heat" width="600" height="60" hidden></canvas>
        </div>
        <button class="btn ghost" id="say"><svg class="i"><use href="#i-volume"/></svg>Listen to result</button>
        <div id="ctx" hidden><h3>Related pages on the web</h3><div id="ctxL"></div><small>These show where the claim appears, not whether the file is real.</small></div>
        <small>This is a guide, not final proof.</small>
      </div>
    </div>
  </div>
</section>

<section id="how">
  <h2>How it works</h2>
  <p class="lead">Three steps, no technical knowledge needed.</p>
  <div class="steps">
    <div class="card"><span class="ico"><svg class="i"><use href="#i-upload"/></svg></span><h3>Add your media</h3><p>Upload a file, or go live with your microphone, camera or a shared window.</p></div>
    <div class="card"><span class="ico"><svg class="i"><use href="#i-activity"/></svg></span><h3>Analyse the signals</h3><p>Trained models score voice, video frames and images for patterns of AI generation.</p></div>
    <div class="card"><span class="ico"><svg class="i"><use href="#i-check"/></svg></span><h3>Read the verdict</h3><p>Get a clear result with a likelihood score and a frame-by-frame breakdown.</p></div>
  </div>
</section>

<footer class="foot">
  <b>Asli Kavach</b>
  <p>Built for Build with Bharat 4.0 at KCC Institute of Technology and Management, Greater Noida.</p>
  <small>Results are AI-assisted assessments, not final proof. Use them alongside context and independent verification.</small>
</footer>
</div>
<script>
/* ---- settings ---- */
const API='http://127.0.0.1:7860';   // where app.py (Gradio) runs
const CDN='https://cdn.jsdelivr.net/npm/@gradio/client/dist/index.min.js';
const FAKE_AT=.65, REAL_AT=.35;     // >= FAKE_AT: AI-made, <= REAL_AT: real, between: not sure
const SHRINK=true;                  // must match how the loaded image model was trained

const S={wait:'Add a file or go live',busy:'Analysing…',real:'Looks real',fake:'Looks AI-generated',maybe:'Not sure',noface:'No face detected',err:'Could not reach the model',
 sub:{wait:'Your result will appear here.',busy:'Scoring the signals. This can take a few seconds.',real:'No strong signs of AI generation were found.',fake:'Signs of AI generation were found.',maybe:'The signals are mixed. Treat it with caution.',noface:'Make sure a face is clearly visible to the camera.',err:'Check that app.py is running, then try again.'}};
const ICON={wait:'upload',busy:'loader',real:'check',fake:'alert',maybe:'help',noface:'scan',err:'ban'};
const svg=n=>'<svg class="i"><use href="#i-'+n+'"/></svg>';
const $=id=>document.getElementById(id);
const avg=a=>a.reduce((x,y)=>x+y,0)/a.length;
let mode='audio',st={k:'wait'},cl=null,live=null;

const api=async(ep,a)=>{ cl??=await (await import(CDN)).Client.connect(API); return (await cl.predict(ep,a)).data[0]; };

/* ---- result display ---- */
function paint(speak){
  const has=typeof st.p==='number';
  $('ic').innerHTML=svg(ICON[st.k]); $('ic').className=st.k==='busy'?'spin':'';
  $('vt').textContent=S[st.k]; $('vs').textContent=S.sub[st.k]; $('box').className='box '+st.k;
  $('bar').style.visibility=has?'visible':'hidden'; $('mk').style.left=has?st.p*100+'%':'0';
  $('pct').textContent=has?'AI-generated likelihood: '+Math.round(st.p*100)+'%':'';
  if(speak) say();
}
function say(){
  if(!window.speechSynthesis) return;
  speechSynthesis.cancel();
  const has=typeof st.p==='number';
  const u=new SpeechSynthesisUtterance(S[st.k]+(has?'. AI-generated likelihood '+Math.round(st.p*100)+' percent.':''));
  u.lang='en-IN'; speechSynthesis.speak(u);
}
function setSt(k){ st={k}; paint(); }
function fail(){ st={k:'err'}; $('sSt').textContent='Error'; paint(true); }
function result(p,per,quiet){
  const k=p>=FAKE_AT?'fake':p<=REAL_AT?'real':'maybe', changed=k!==st.k;
  st={k,p}; paint(!quiet||changed); heat(per);
}
function heat(a){
  const c=$('heat'); c.hidden=!(a&&a.length>1); if(c.hidden) return;
  const x=c.getContext('2d'), w=c.width/a.length; x.clearRect(0,0,c.width,c.height);
  a.forEach((p,i)=>{ x.fillStyle=p>=.5?'rgba(255,95,95,'+(.35+1.3*(p-.5))+')':'rgba(51,216,156,'+(.35+1.3*(.5-p))+')'; x.fillRect(i*w,0,Math.max(w-2,1),c.height); });
}

/* ---- mode, reset, buttons ---- */
function labels(){
  $('liveI').innerHTML=svg(live?'stop':mode==='audio'?'mic':'camera');
  $('liveT').textContent=live?'Stop':mode==='audio'?'Listen live':'Start camera';
  $('liveBtn').classList.toggle('red',!!live); $('scrBtn').disabled=!!live;
}
function reset(){
  stopLive();
  const v=$('vid'); v.pause(); v.removeAttribute('src'); v.srcObject=null; v.style.display='none';
  $('img').style.display='none'; $('img').removeAttribute('src');
  $('wave').style.display='block'; $('ph').style.display='flex'; $('ph').innerHTML=svg({audio:'mic',video:'video',image:'image'}[mode])+'<span>Drop a file here</span>';
  $('heat').hidden=true; $('ctx').hidden=true; $('sLat').textContent='—'; $('sFr').textContent='—'; $('sSt').textContent='Idle';
  labels(); setSt('wait');
}
function setMode(m){
  mode=m;
  document.querySelectorAll('.seg button').forEach(b=>b.classList.toggle('on',b.dataset.m===m));
  $('f').accept={audio:'audio/*',video:'video/*',image:'image/*'}[m];
  $('liveBtn').hidden=m==='image'; $('scrBtn').hidden=m!=='video';
  reset();
}
function stopLive(){
  if(!live) return;
  const l=live; live=null; l.stop(); labels(); $('sSt').textContent='Idle';
}
$('liveBtn').onclick=()=>live?stopLive():(mode==='audio'?startMic():startCam('camera'));
$('scrBtn').onclick=()=>{ if(!live) startCam('screen'); };
$('pick').onclick=()=>{ stopLive(); $('f').click(); };
$('f').onchange=()=>{ const f=$('f').files[0]; $('f').value=''; if(f) runFile(f); };
$('say').onclick=say;

/* ---- check a chosen file (runs automatically) ---- */
async function runFile(f){
  reset(); const u=URL.createObjectURL(f), m=mode;
  if(m==='video'){ $('vid').src=u; $('vid').controls=true; $('vid').style.display='block'; $('wave').style.display='none'; $('ph').style.display='none'; }
  else if(m==='image'){ $('img').src=u; $('img').style.display='block'; $('wave').style.display='none'; $('ph').style.display='none'; }
  else $('ph').innerHTML=svg('mic');
  setSt('busy'); $('sSt').textContent='Working'; const t0=performance.now();
  try{
    const r=await api({audio:'/detect_audio',video:'/detect_video',image:'/detect'}[m], m==='image'?[f,SHRINK]:[f]);
    if(m!==mode) return;
    if(typeof r.fake_prob!=='number') throw new Error('no score');
    result(r.fake_prob,r.per_frame);
    $('sLat').textContent=Math.round(performance.now()-t0)+' ms';
    $('sFr').textContent=r.frames_flagged!=null?r.frames_flagged+'/'+r.frames_checked:(r.frames_checked||1);
    $('sSt').textContent='Done'; ctx();
  }catch(e){ console.error(e); cl=null; fail(); }
}

/* ---- related web pages for the caption/claim (backend /context) ---- */
async function ctx(){
  const q=$('cap').value.trim(), ls=$('ctxL'); ls.textContent=''; $('ctx').hidden=!q; if(!q) return;
  try{
    const o=await api('/context',[q]); if(o.error) throw new Error(o.error);
    (o.results||[]).forEach(x=>{
      if(!/^https?:\/\//i.test(x.url)) return;
      const a=document.createElement('a'); a.href=x.url; a.target='_blank'; a.rel='noopener noreferrer'; a.textContent=x.title||x.url; ls.append(a);
    });
  }catch(e){ console.error(e); ls.textContent=S.err; }
}

/* ---- live microphone: every ~3 s of speech is scored by /detect_audio ---- */
function wav16(ch,sr){
  let n=0; ch.forEach(c=>n+=c.length);
  const a=new Float32Array(n); let o=0; ch.forEach(c=>{ a.set(c,o); o+=c.length; });
  const r=sr/16000, m=Math.floor(a.length/r), p=new Int16Array(m);
  for(let i=0;i<m;i++){
    const s=Math.floor(i*r), e=Math.min(a.length,Math.floor((i+1)*r)); let t=0,c=0;
    for(let j=s;j<e;j++){ t+=a[j]; c++; }
    const v=Math.max(-1,Math.min(1,c?t/c:0)); p[i]=v<0?v*32768:v*32767;
  }
  const b=new ArrayBuffer(44+p.length*2), d=new DataView(b), w=(f,s)=>[...s].forEach((c,i)=>d.setUint8(f+i,c.charCodeAt(0)));
  w(0,'RIFF'); d.setUint32(4,36+p.length*2,true); w(8,'WAVEfmt '); d.setUint32(16,16,true); d.setUint16(20,1,true); d.setUint16(22,1,true);
  d.setUint32(24,16000,true); d.setUint32(28,32000,true); d.setUint16(32,2,true); d.setUint16(34,16,true); w(36,'data'); d.setUint32(40,p.length*2,true);
  new Int16Array(b,44).set(p);
  return new Blob([b],{type:'audio/wav'});
}
async function startMic(){
  let ms; try{ ms=await navigator.mediaDevices.getUserMedia({audio:true}); }catch(e){ return fail(); }
  reset();
  const ac=new AudioContext(), src=ac.createMediaStreamSource(ms), an=ac.createAnalyser(), pr=ac.createScriptProcessor(4096,1,1);
  const o={buf:[],len:0,busy:false,sc:[],n:0}, cv=$('wave'), cx=cv.getContext('2d'); let raf;
  an.fftSize=2048; src.connect(an); src.connect(pr); pr.connect(ac.destination);
  const draw=()=>{ raf=requestAnimationFrame(draw); const d=new Uint8Array(an.fftSize); an.getByteTimeDomainData(d);
    cx.clearRect(0,0,cv.width,cv.height); cx.strokeStyle='#138808'; cx.lineWidth=2; cx.beginPath();
    d.forEach((v,i)=>{ const x=i*cv.width/d.length, y=v/128*cv.height/2; i?cx.lineTo(x,y):cx.moveTo(x,y); }); cx.stroke(); };
  pr.onaudioprocess=e=>{ const d=new Float32Array(e.inputBuffer.getChannelData(0)); o.buf.push(d); o.len+=d.length; if(o.len>=ac.sampleRate*3) flushMic(o,ac.sampleRate); };
  live={stop(){ cancelAnimationFrame(raf); pr.onaudioprocess=null; try{pr.disconnect();}catch(e){} ms.getTracks().forEach(t=>t.stop()); ac.close(); cx.clearRect(0,0,cv.width,cv.height); $('ph').style.display='flex'; }};
  $('ph').style.display='none'; draw(); labels(); $('sSt').textContent='Live'; setSt('busy');
}
async function flushMic(o,rate){
  const ch=o.buf; o.buf=[]; o.len=0; if(o.busy) return;
  let s=0,n=0; ch.forEach(c=>{ for(let i=0;i<c.length;i+=8){ s+=c[i]*c[i]; n++; } });
  if(Math.sqrt(s/Math.max(n,1))<.01) return;                // silence: nothing to score
  o.busy=true; const t0=performance.now();
  try{
    const r=await api('/detect_audio',[new File([wav16(ch,rate)],'mic.wav',{type:'audio/wav'})]);
    if(!live) return;
    o.sc.push(r.fake_prob); if(o.sc.length>6) o.sc.shift(); o.n++;
    $('sFr').textContent=o.n; $('sLat').textContent=Math.round(performance.now()-t0)+' ms';
    result(avg(o.sc.slice(-3)),o.sc,true);
  }catch(e){ console.error(e); cl=null; stopLive(); fail(); }
  finally{ o.busy=false; }
}

/* ---- live camera / shared window: 1 face-checked frame per second via /detect_frame ---- */
async function startCam(src){
  let ms;
  try{ ms=await (src==='screen'?navigator.mediaDevices.getDisplayMedia({video:true}):navigator.mediaDevices.getUserMedia({video:{facingMode:'user',width:{ideal:640}}})); }
  catch(e){ return fail(); }
  reset();
  const v=$('vid'), cv=document.createElement('canvas'), cx=cv.getContext('2d'), probs=[]; let busy=false,n=0,miss=0;
  v.srcObject=ms; v.controls=false; v.muted=true; v.style.display='block'; $('wave').style.display='none'; $('ph').style.display='none';
  try{ await v.play(); }catch(e){}
  const tick=async()=>{
    if(busy||!v.videoWidth) return; busy=true; const t0=performance.now();
    try{
      const W=Math.min(v.videoWidth,src==='screen'?1280:640); cv.width=W; cv.height=Math.round(W*v.videoHeight/v.videoWidth); cx.drawImage(v,0,0,cv.width,cv.height);
      const b=await new Promise(r=>cv.toBlob(r,'image/jpeg',.85));
      const r=await api('/detect_frame',[new File([b],'frame.jpg',{type:'image/jpeg'}),SHRINK]);
      if(!live) return;
      if(!r.face_found){ miss++; if(miss>=3||!probs.length) setSt('noface'); return; }
      miss=0; probs.push(r.fake_prob); if(probs.length>24) probs.shift(); n++;
      $('sFr').textContent=n; $('sLat').textContent=Math.round(performance.now()-t0)+' ms';
      if(probs.length>=3) result(avg(probs.slice(-8)),probs,true);
    }catch(e){ console.error(e); cl=null; stopLive(); fail(); }
    finally{ busy=false; }
  };
  const iv=setInterval(tick,1000);
  live={stop(){ clearInterval(iv); ms.getTracks().forEach(t=>t.stop()); v.pause(); v.srcObject=null; v.controls=true; v.style.display='none'; $('wave').style.display='block'; $('ph').style.display='flex'; }};
  ms.getVideoTracks()[0].onended=stopLive;
  labels(); $('sSt').textContent='Live'; setSt('busy'); tick();
}

/* ---- start ---- */
document.querySelectorAll('.seg button').forEach(b=>b.onclick=()=>setMode(b.dataset.m));
const vz=document.querySelector('.viz'); vz.ondragover=e=>e.preventDefault(); vz.ondrop=e=>{ e.preventDefault(); const f=e.dataTransfer.files[0]; if(f) runFile(f); };
setMode('audio');
</script>
<script>
/* planes with tiranga smoke trails: saffron, white and green jets cross from both sides */
(()=>{const jet='<svg viewBox="0 0 120 40"><path d="M2 20L40 14L70 2h12L70 16l42 2 6 2-6 2-42 2 12 14H70L40 26z" fill="currentColor"/></svg>';
[['#FF9933',.4,16],['#ffffff',2.6,30],['#138808',4.8,8]].forEach(([c,d,y])=>['l','r'].forEach((s,j)=>{
  const f=document.createElement('div'); f.className='fly '+s;
  f.style.cssText='--c:'+c+';--d:'+(d+j*1.2)+'s;--y:'+(y+j*7)+'vh';
  f.innerHTML='<i class="trail"></i>'+jet; $('sky').insertBefore(f,$('skyline'));
}));})();
</script>
